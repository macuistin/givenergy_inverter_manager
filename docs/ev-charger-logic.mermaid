---
title: EV charging decisions (decide_ev_charger_action in rules.py, battery hold in battery_hold.py)
---
flowchart TD
    START(["Every 30 s cycle, a car set up with an EV charger"]) --> WINDOW{"Inside the charge window?\nCharge Start Time to Charge End Time,\ncharger has a Fast mode"}

    WINDOW -- Yes --> PLUGGED{"EV plugged in?"}
    PLUGGED -- No --> NONE1(["No action\nnot connected"])
    PLUGGED -- Yes --> INFAST{"Already in Fast?"}
    INFAST -- Yes --> NONE2(["No action"])
    INFAST -- No --> FAST(["Request Fast\nPause and Charge now step aside"])

    WINDOW -- No --> PAUSE{"Pause on?"}
    PAUSE -- Yes --> STOPPED(["Request Stopped\nunless already Stopped"])
    PAUSE -- No --> NOW{"Charge now on\nand a car plugged in?"}
    NOW -- Yes --> FAST2(["Request Fast\nunless already in Fast"])
    NOW -- No --> HELD{"In Fast, and this\nintegration set it?"}
    HELD -- Yes --> BACK(["Request Eco+ once\nwindow over, back to Eco+"])
    HELD -- No --> UNPLUGGED{"EV plugged in?"}
    UNPLUGGED -- No --> NONE3(["No action\nnot connected, never Stopped"])
    UNPLUGGED -- Yes --> SURPLUS{"Solar surplus below\n1,380 W?"}
    SURPLUS -- Yes --> NONE4(["No action\nbelow the charger minimum, mode left alone"])
    SURPLUS -- No --> ECO{"Eco+ or Solar already on?"}
    ECO -- Yes --> NONE5(["No action"])
    ECO -- No --> ECOPLUS(["Request Eco+ or Solar\nabsorb the solar surplus"])

    FAST --> APPLY["coordinator._apply_ev_action\nskipped in dry run\nskipped inside the write cooldown"]
    FAST2 --> APPLY
    STOPPED --> APPLY
    BACK --> APPLY
    ECOPLUS --> APPLY

    HOLDSTART(["Battery hold, a separate step in the same cycle"]) --> DRAIN{"Car charging and the\nbattery discharging over 200 W?"}
    DRAIN -- No --> HNONE1(["No hold\nthe battery is free to charge and discharge"])
    DRAIN -- Yes --> HOLDON{"Hold switch on,\nor Charge now on?"}
    HOLDON -- No --> HNONE2(["No hold"])
    HOLDON -- Yes --> PAUSED{"A pause already stops charging,\nalready covers now,\nor cannot be read?"}
    PAUSED -- Yes --> HNONE3(["Leave the pause alone"])
    PAUSED -- No --> HOLD(["Write PauseDischarge for 30 minutes\nrenew while the car charges\nrestore the saved pause 5 minutes after it stops"])
    HOLD --> NOCHARGE["Never writes the charge slot, target,\nrate or enable switches, so the battery\ncharges while the car charges"]

    style FAST fill:#e3f2fd,stroke:#1976d2
    style FAST2 fill:#e3f2fd,stroke:#1976d2
    style ECOPLUS fill:#e8f5e9,stroke:#4CAF50
    style BACK fill:#e8f5e9,stroke:#4CAF50
    style STOPPED fill:#fff3e0,stroke:#f57c00
    style HOLD fill:#fff3e0,stroke:#f57c00
    style NONE1 fill:#f5f5f5,stroke:#9e9e9e
    style NONE2 fill:#f5f5f5,stroke:#9e9e9e
    style NONE3 fill:#f5f5f5,stroke:#9e9e9e
    style NONE4 fill:#f5f5f5,stroke:#9e9e9e
    style NONE5 fill:#f5f5f5,stroke:#9e9e9e
    style HNONE1 fill:#f5f5f5,stroke:#9e9e9e
    style HNONE2 fill:#f5f5f5,stroke:#9e9e9e
    style HNONE3 fill:#f5f5f5,stroke:#9e9e9e
