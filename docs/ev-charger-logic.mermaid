---
title: EV Charger Decision Logic (decide_ev_charger_action in rules.py)
---
flowchart TD
    START([Called from engine.py\neach 30s update cycle]) --> PLUGGED{EV plugged in?}
    PLUGGED -- No --> NONE1(["No action\n(not connected)"])

    PLUGGED -- Yes --> MINPOWER{solar_surplus_w\n< EV_CHARGER_MIN_POWER_W\n(1,380 W)?}

    MINPOWER -- Yes --> NONE2(["No action\n(below the charger minimum)"])

    MINPOWER -- No --> ZAPPI{Zappi?}

    ZAPPI -- No --> NONE3(["No action\n(signals only for other brands)"])

    ZAPPI -- Yes --> ECO{already\nin Eco+?}
    ECO -- Yes --> NONE4(["No action\n(already in Eco+)"])
    ECO -- No --> ECOPLUS(["Request mode → Eco+\n(absorb solar surplus)"])

    ECOPLUS --> APPLY["coordinator._apply_ev_action\nskipped in dry run\nskipped if written in the last 300 s"]

    style ECOPLUS fill:#e8f5e9,stroke:#4CAF50
    style NONE1 fill:#f5f5f5,stroke:#9e9e9e
    style NONE2 fill:#f5f5f5,stroke:#9e9e9e
    style NONE3 fill:#f5f5f5,stroke:#9e9e9e
    style NONE4 fill:#f5f5f5,stroke:#9e9e9e
